Algoritmo "CalcularMedia"
// Disciplina   : LP1
// Professor    : Adriana
// Descrição    : Calcula média do aluno
// Autor(a)     : Eduardo Nakano
// Data atual   : 11/08/2026

Var
// Seção de Declarações das variáveis
p1,e1,e2, x, sub, api, exf, total, media:real

Inicio
// Solicita entrada do usuário
escreval("Digite a nota da P1: ")
leia(p1)
escreval("Digite a nota da E1: ")
leia(e1)
escreval("Digite a nota da E2: ")
leia(e2)
escreval("Digite a nota das Atividade extras: ")
leia(x)
escreval("Digite a nota da Sub: ")
leia(sub)
escreval("Digite a nota da API: ")
leia(api)

// Cálculo da base da operação
total <- p1*0.5 + e1*0.2 + e2*0.3 + x

// Verifica se o total é maior que 6 e calcula a média do aluno
se total < 6 entao
     total <- total + (sub*0.15)
     se total < 6 entao
        media <- total*0.5
     senao
        media <- total*0.5 + api*0.5
     fimse
senao
     media <- total*0.5 + api*0.5
fimse

// Caso aluno tenha feito a EXF analisa se é viável substituir média
escreval("Caso tenha realizado a EXF, digite a nota: ")
leia(exf)
se exf > media entao
   media <- exf
fimse

// Limita média para valores entre 0 e 10
se media < 0 entao
   escreval("Erro! Verificar se notas estão entre 0 e 10")
fimse
se media > 10 entao
   media <- 10
fimse

// Exibe o resultado da operação para cada caso
se media >= 6 entao
    escreval("======= MÉDIA FINAL ========")
    escreval(media)
    escreval("======== Aprovado! =========")
senao
    escreval("======= MÉDIA FINAL ========")
    escreval(media)
    escreval("======== Reprovado =========")
fimse

Fimalgoritmo
