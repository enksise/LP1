import java.util.Scanner;
public class exercicio1 {

    public static void main(String[] args) {

        // Cria um scanner para leitura da entrada do usuário
        Scanner sc = new Scanner(System.in);

        // Declara variável das notas
        double p1, e1, e2, x, sub, api, exf, total, media;

        //Solicita preenchimento das notas do aluno
        System.out.println("Digite a nota da P1: ");
        p1 = sc.nextDouble();
        System.out.println("Digite a nota da E1: ");
        e1 = sc.nextDouble();
        System.out.println("Digite a nota da E2: ");
        e2 = sc.nextDouble();
        System.out.println("Digite a nota das Atividades extras: ");
        x = sc.nextDouble();
        System.out.println("Digite a nota da Sub: ");
        sub = sc.nextDouble();
        System.out.println("Digite a nota da API: ");
        api = sc.nextDouble();

        //Calcula a base da operação
        total = (p1*0.5) + (e1*0.2) + (e2*0.3) + x;

        if (total < 6) {
            total = total + (sub * 0.15);
            if (total < 6) {
                media = total * 0.5;
            } else {
                media = (total * 0.5) + (api * 0.5);
            }
        }else {
            media = (total * 0.5) + (api * 0.5);
        }

        //Caso aluno tenha feito a EXF analisa se é viável
        System.out.println("Caso tenha realizado a EXF, digite a nota: ");
        exf = sc.nextDouble();
        if (exf > media) {
            media = exf;
        }

        // Limita média para valores entre 0 e 10
        if (media < 0) {
            System.out.println("Erro!, Verificar se notas estão entre 0 e 10.");
        } else if (media > 10) {
            media = 10;
        }

        if (media >= 6){
            System.out.println();
            System.out.println("MÉDIA FINAL: " + media);
            System.out.println("==========================");
            System.out.println("APROVADO");
            System.out.println("==========================");
        }else{
            System.out.println();
            System.out.println("MÉDIA FINAL: " + media);
            System.out.println("==========================");
            System.out.println("REPROVADO!");
            System.out.println("==========================");
        }
    }
}
